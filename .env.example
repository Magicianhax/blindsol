# ─── MagicBlock Private Payments ──────────────────────────────────────
MAGICBLOCK_API_BASE=https://payments.magicblock.app
MAGICBLOCK_CLUSTER=mainnet
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ─── Solana RPCs ──────────────────────────────────────────────────────
# Public api.mainnet-beta.solana.com BLOCKS browser-origin calls with 403,
# so use a real RPC provider. Helius free tier works (https://helius.dev,
# 30-second signup). Format: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=
# Same URL is exposed to the browser via Next.js (must have NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SOLANA_RPC_URL=

# ─── Privy (wallet auth — embedded + external wallets) ────────────────
# Sign up at https://dashboard.privy.io, create an app, enable Solana under
# both External Wallets and Embedded Wallets, then paste the App ID below.
# Free tier covers 1,000 monthly active users.
# Format: 25-char alphanumeric, looks like "cm1a2b3c4d5e6f7g8h9i0jklm"
NEXT_PUBLIC_PRIVY_APP_ID=cm1a2b3c4d5e6f7g8h9i0jklm
# Network where the Anchor badge_registry is deployed
# (devnet for the prototype, switch to mainnet-beta when promoting)
BADGE_RPC_URL=https://api.devnet.solana.com

# ─── Postgres ─────────────────────────────────────────────────────────
# Get a free database from https://neon.tech, paste its connection string here
# Format: postgres://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=

# REQUIRED if you ever run `pnpm --filter @blindsol/api test`. Integration
# tests truncate posts/comments/reactions; if you point them at the prod
# DB they'll wipe real user data. Spin up a second Neon project (free) and
# paste its URL here. The test runner refuses to start if this equals
# DATABASE_URL, and skips integration tests entirely if it's unset.
DATABASE_URL_TEST=

# ─── API ──────────────────────────────────────────────────────────────
API_PORT=3001

# ─── Anthropic (moderation agent — optional) ──────────────────────────
ANTHROPIC_API_KEY=

# ─── PER signing key (REQUIRED) ───────────────────────────────────────
# Signs every badge token + per-action attestation. Pinning this key keeps
# outstanding badge tokens valid across API restarts.
# Generate a fresh pair with:
#   pnpm --filter @blindsol/api exec tsx scripts/gen-per-key.ts
PER_DEV_SECRET=
PER_ATTESTATION_PUBKEY=

# ─── Stake-bond pipeline ──────────────────────────────────────────────
# Each post requires the user's wallet to pay STAKE_PER_POST_RAW USDC into
# the stake pool below via a MagicBlock private transfer. The server only
# verifies the on-chain tx — it never holds funds.
# Generate the pool pubkey once (no secret stored in env):
#   solana-keygen new --no-bip39-passphrase --outfile /tmp/stake-pool.json
#   solana-keygen pubkey /tmp/stake-pool.json
STAKE_POOL_PUBKEY=
# 100000 = 0.1 USDC at 6 decimals
STAKE_PER_POST_RAW=100000

# ─── On-chain badge registry ──────────────────────────────────────────
# Deploy the program once with:
#   bash scripts/deploy-badge-registry.sh
#   pnpm --filter @blindsol/api registry:init
# The authority keypair signs initialize_registry + every mint_badge call.
BADGE_PROGRAM_ID=
BADGE_AUTHORITY_KEYPAIR=
