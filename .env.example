# MagicBlock Private Payments API
MAGICBLOCK_API_BASE=https://payments.magicblock.app
MAGICBLOCK_MCP_URL=https://payments.magicblock.app/v1/mcp

# USDC mint on Solana mainnet
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Privy server wallet (for badge issuance + post staking)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Anthropic (moderation agent)
ANTHROPIC_API_KEY=

# Postgres connection string.
# Easiest: free Neon database from https://neon.tech (no install).
#   Format: postgres://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
# Local Docker alternative: postgres://blindsol:blindsol@localhost:5432/blindsol
DATABASE_URL=

# API
API_PORT=3001

# PER attestation pubkey (the public key we trust to sign attestations)
# In dev we generate one; in prod this is MagicBlock's PER signer
PER_ATTESTATION_PUBKEY=
# Optional fixed PER signing key for dev. If unset, the API autogenerates one
# at boot (which is fine, but every restart invalidates outstanding badge tokens).
PER_DEV_SECRET=

# Per-app fallback keypair for dev only (BASE58 secret key)
DEV_KEYPAIR_SECRET=

# ─── MagicBlock Private Payments stake escrow (Phase 10a) ────────────
# Run: cd apps/api && npx tsx scripts/gen-house-wallet.ts
# Then fund the printed pubkey with ~0.05 SOL + ~5 USDC and set:
MAGICBLOCK_ENABLED=false
HOUSE_WALLET_SECRET=
HOUSE_WALLET_PUBKEY=
STAKE_POOL_PUBKEY=
STAKE_POOL_SECRET=
# Per-post stake in raw token units (USDC has 6 decimals; 100000 = 0.1 USDC)
STAKE_PER_POST_RAW=100000
