# MagicBlock Private Payments API
MAGICBLOCK_API_BASE=https://payments.magicblock.app
MAGICBLOCK_MCP_URL=https://payments.magicblock.app/v1/mcp

# USDC mint on Solana mainnet
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Privy server wallet (for badge issuance + post staking)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Anthropic (moderation agent)
ANTHROPIC_API_KEY=

# Postgres (local dev: docker-compose up; prod: Neon)
DATABASE_URL=postgres://blindsol:blindsol@localhost:5432/blindsol

# API
API_PORT=3001

# PER attestation pubkey (the public key we trust to sign attestations)
# In dev we generate one; in prod this is MagicBlock's PER signer
PER_ATTESTATION_PUBKEY=

# Per-app fallback keypair for dev only (BASE58 secret key)
DEV_KEYPAIR_SECRET=
