{
  "name": "@agentpay/magicblock-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./signers/keypair": "./src/signers/keypair.ts",
    "./signers/privy": "./src/signers/privy.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
